{
  "entities": {
    "User": {
      "title": "User",
      "description": "Tutor user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email"]
    },
    "Student": {
      "title": "Student",
      "description": "Student enrolled with the tutor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "parentPhone": { "type": "string" },
        "grade": { "type": "string" },
        "batch": { "type": "string" },
        "subjects": { "type": "array" },
        "monthlyFee": { "type": "number" },
        "billingType": { "type": "string" },
        "paymentCycleDay": { "type": "integer" },
        "joiningDate": { "type": "string" },
        "notes": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "monthlyFee", "active"]
    },
    "FeeRecord": {
      "title": "FeeRecord",
      "description": "Fee billing invoice or ledger item for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "monthYear": { "type": "string" },
        "dueDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "status": { "type": "string" },
        "advanceAdjusted": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "studentId", "totalAmount", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment receipt collected from a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "feeRecordId": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "transactionReference": { "type": "string" },
        "paymentDate": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "studentId", "amount", "paymentMethod", "receiptNumber"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Tutor user profile document"
    },
    "/users/{userId}/students/{studentId}": {
      "schema": "Student",
      "description": "Students belonging to the authenticated tutor"
    },
    "/users/{userId}/fee_records/{recordId}": {
      "schema": "FeeRecord",
      "description": "Fee ledger and billing records for the tutor's students"
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment transaction history and receipts for the tutor"
    }
  }
}
